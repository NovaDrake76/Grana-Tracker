# Grana Tracker — frontend env vars
#
# Local dev: copia este arquivo pra .env.local (ou .env) e deixa o backend Go
# rodando em http://localhost:8080. O sufixo /api é obrigatório porque o backend
# monta todas as rotas sob esse prefixo.
#
# Vercel (produção):
#   1. Project Settings > General > Root Directory = "frontend"
#      (sem isso o Vercel tenta buildar a raiz do monorepo e quebra)
#   2. Framework Preset: Next.js (autodetectado)
#   3. Settings > Environment Variables > adicionar:
#        NEXT_PUBLIC_API_URL = https://<seu-backend>.onrender.com/api
#      Marcar como Production (e Preview, se quiser PRs com backend real).
#      Variáveis NEXT_PUBLIC_* são lidas no BUILD — qualquer mudança exige
#      novo deploy pra propagar.

NEXT_PUBLIC_API_URL=http://localhost:8080/api
