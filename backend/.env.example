DATABASE_URL=
JWT_SECRET=
# ALPHA_VANTAGE_API_KEY: free-tier key from https://www.alphavantage.co/support/#api-key.
# Common placeholders ("", "your-key", "YOUR_KEY", "changeme", "demo") are
# detected at boot and short-circuit the stock/ETF/index pricing source —
# the rest of the app keeps working with crypto prices via CoinGecko.
ALPHA_VANTAGE_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
PORT=8080
# FRONTEND_URL accepts a COMMA-SEPARATED list of allowed CORS origins so the
# same backend can serve both production (Vercel) and local dev. Trim spaces
# are tolerated. Example:
#   FRONTEND_URL=https://grana-tracker.vercel.app,http://localhost:3000
FRONTEND_URL=http://localhost:3000
